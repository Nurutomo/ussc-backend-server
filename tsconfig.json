{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "types": ["vite/client", "node"]
  },
  "include": ["frontend/**/*.ts", "frontend/**/*.tsx", "frontend/**/*.d.ts", "types/**/*.ts", "types/**/*.d.ts"],
  "exclude": ["frontend/build"]
}
